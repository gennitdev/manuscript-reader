{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["vite.config.ts", "src/content/**/*.ts", "tests/**/*.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest/globals"],
    "strict": true,
    "noUncheckedIndexedAccess": true
  }
}
